# Copy from the setup-generated .env.hermes, or configure an existing gateway.
HERMES_BASE_URL=http://127.0.0.1:8642
# Must match API_SERVER_KEY in the dedicated Hermes home; keep this server-side.
HERMES_API_KEY=
# Gateway alias; the underlying Qwen model is configured in Hermes config.yaml.
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_SECONDS=120
